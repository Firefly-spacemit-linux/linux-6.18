#!/bin/sh
# SPDX-License-Identifier: GPL-2.0

UTS_MACHINE=$1
CC_VERSION="$2"
LD=$3

if test -z "$KBUILD_BUILD_USER"; then
	LINUX_COMPILE_BY=$(whoami | sed 's/\\/\\\\/')
else
	LINUX_COMPILE_BY=$KBUILD_BUILD_USER
fi
if test -z "$KBUILD_BUILD_HOST"; then
	LINUX_COMPILE_HOST=`uname -n`
else
	LINUX_COMPILE_HOST=$KBUILD_BUILD_HOST
fi

LD_VERSION=$(LC_ALL=C $LD -v | head -n1 |
		sed -e 's/(compatible with [^)]*)//' -e 's/[[:space:]]*$//')

LINUX_SOURCE=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
LINUX_GIT_TREE=$LINUX_SOURCE
unset GIT_DIR GIT_WORK_TREE

SDK_ROOT=
SEARCH_PATH=$LINUX_SOURCE
while :; do
	if test -f "$SEARCH_PATH/.repo/manifest.xml"; then
		SDK_ROOT=$SEARCH_PATH
		break
	fi
	test "$SEARCH_PATH" = / && break
	SEARCH_PATH=$(dirname "$SEARCH_PATH")
done

if ! git -C "$LINUX_GIT_TREE" rev-parse --git-dir >/dev/null 2>&1 &&
		test -n "$SDK_ROOT"; then
	REPO_GIT_TREE=$SDK_ROOT/.repo/projects/bsp-src/linux-6.18.git
	test ! -d "$REPO_GIT_TREE" || LINUX_GIT_TREE=$REPO_GIT_TREE
fi

LINUX_BRANCH=$(git -C "$LINUX_GIT_TREE" rev-parse --abbrev-ref HEAD)
LINUX_COMMIT=$(git -C "$LINUX_GIT_TREE" rev-parse --short=12 HEAD)
LINUX_COMPILE_TIME=$(date +%y%m%d)
XML_PATH=
XML_NAME=
if test -n "$SDK_ROOT"; then
	XML_PATH=$(readlink -f "$SDK_ROOT/.repo/manifest.xml")
	XML_NAME=$(sed -n 's/.*<include[^>]*name="\([^"]*\)".*/\1/p' \
		"$XML_PATH" | head -n1)
	test -n "$XML_NAME" || XML_NAME=${XML_PATH##*/}
fi

cat <<EOF
#define UTS_MACHINE		"${UTS_MACHINE}"
#define LINUX_COMPILE_BY	"${LINUX_COMPILE_BY}"
#define LINUX_COMPILE_HOST	"${LINUX_COMPILE_HOST}"
#define LINUX_COMPILER		"${CC_VERSION}, ${LD_VERSION}"
#define LINUX_COMMIT 		"$LINUX_COMMIT"
#define LINUX_BRANCH 		"$LINUX_BRANCH"
#define LINUX_COMPILE_TIME	"$LINUX_COMPILE_TIME"
#define XML_NAME 		"sdk version: $XML_NAME"
EOF

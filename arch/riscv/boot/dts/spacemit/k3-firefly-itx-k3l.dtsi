		};

		link1_codec: codec {
			sound-dai = <&es8390>;
		};
	};
};

&gpio {
	gpio-ranges = <&pinctrl 0 0 0   6>,
		      <&pinctrl 0 6 143 1>,
		      <&pinctrl 0 7 7   25>,
		      <&pinctrl 1 0 32 32>,
		      <&pinctrl 2 0 64 32>,
		      <&pinctrl 3 0 96 32>;
};

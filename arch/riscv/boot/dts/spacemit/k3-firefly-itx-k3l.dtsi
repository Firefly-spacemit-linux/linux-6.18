&pinctrl {
	i2c0-0-cfg {
		i2c0-0-pins {
			power-source = <1800>;
		};
	};

	i2c1-1-cfg {
		i2c1-0-pins {
			power-source = <1800>;
		};
	};

	i2c3-2-cfg {
		i2c3-0-pins {
			power-source = <3300>;
		};
	};

	i2c4-3-cfg {
		i2c4-0-pins {
			power-source = <3300>;
		};
	};

	i2c5-2-cfg {
		i2c5-0-pins {
			power-source = <3300>;
		};
	};

	i2c6-0-cfg {
		i2c6-0-pins {
			power-source = <1800>;
		};
	};

	ri2c0-3-cfg {
		ri2c0-0-pins {
			bias-disable;			/* normal bias disable */
			power-source = <3300>;
		};
	};

	ri2c1-1-cfg {
		ri2c1-0-pins {
			bias-disable;			/* normal bias disable */
			power-source = <1800>;
		};
	};


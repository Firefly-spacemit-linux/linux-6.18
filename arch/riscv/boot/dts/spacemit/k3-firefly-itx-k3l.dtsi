// BT portb usb2.0
&usb3_portb_u2phy {
	status = "okay";
};

&usb3_portb_u3phy {
	status = "disabled";
};

&usb3_portb {
	// First, delete the pre-configured dual PHY references in the SoC DTSI, then reconfigure it for USB 2.0 PHY only.
        /delete-property/ phys;
        /delete-property/ phy-names;
        maximum-speed = "high-speed";
        phys = <&usb3_portb_u2phy>;
        phy-names = "usb2-phy";
        reset-on-resume;
	status = "okay";
};
#endif


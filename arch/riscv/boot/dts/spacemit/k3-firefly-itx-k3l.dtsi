			pinmux = <K3_PADCONF(110, 0)>;

			bias-disable;			/* normal bias disable */
			drive-strength = <25>;		/* DS8 */
			power-source = <3300>;
		};
	};
#endif

#ifdef FF_ES8390
	sspa1_0_cfg: sspa1-0-cfg {
		sspa1-0-pins {
			power-source = <1800>;
		};
	};
#endif

#ifdef FF_USB30_TYPEA
#ifdef FF_USB30_FRONT
	usb30_front_pwren_cfg: usb30-front-pwren-cfg {
		usb30-front-pwren-pin {
			pinmux = <K3_PADCONF(105, 0)>;

			bias-disable;			/* normal bias disable */
			drive-strength = <25>;		/* DS8 */
			power-source = <3300>;
		};
	};
#endif
#endif
};
